# {{ ansible_managed }}
# ↑ Ansible reemplaza esto por un aviso de "archivo administrado por Ansible, no editar a mano".

# [base] = identificador del repositorio: paquetes originales de CentOS 7.9
[base]
# Nombre descriptivo que muestra yum
name=CentOS-7 - Base (vault)
# URL fija del archivo histórico ($basearch = arquitectura, ej. x86_64)
baseurl=https://vault.centos.org/7.9.2009/os/$basearch/
# Verificar la firma GPG de cada paquete
gpgcheck=1
# Llave pública con la que se verifican las firmas
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7

# [updates] = actualizaciones publicadas después del release
[updates]
name=CentOS-7 - Updates (vault)
baseurl=https://vault.centos.org/7.9.2009/updates/$basearch/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7

# [extras] = paquetes adicionales (aquí vive epel-release)
[extras]
name=CentOS-7 - Extras (vault)
baseurl=https://vault.centos.org/7.9.2009/extras/$basearch/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
